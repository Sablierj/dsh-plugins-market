{
  "name": "@local/dsh-web-search-searxng",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "SearXNG for DSH: self-deploys the container, manages it from a settings panel, and serves web search through it (proxy / Clash aware).",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
