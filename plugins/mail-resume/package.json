{
  "name": "@local/dsh-plugin-mail-resume",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "企业邮箱简历自动下载：从腾讯企业邮里捞出 BOSS 直聘的简历邮件，把近 N 天还没下载的附件简历一键落到本机下载目录，并记录台账去重。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cdp.js",
    "exmail.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dependencies": {
    "ws": "^8.18.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
